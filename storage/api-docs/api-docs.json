{
    "openapi": "3.0.0",
    "info": {
        "title": "Vitalis Shop API",
        "description": "REST API for Vitalis Shop",
        "version": "1.0.0"
    },
    "servers": [
        {
            "url": "http://127.0.0.1:8000",
            "description": "Local development server"
        }
    ],
    "paths": {
        "/api/products": {
            "get": {
                "tags": [
                    "Products"
                ],
                "summary": "Get all products",
                "operationId": "56e55c22eca63e7fea3119a8b0c7cfdf",
                "responses": {
                    "200": {
                        "description": "List of products",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "array",
                                    "items": {
                                        "$ref": "#/components/schemas/Product"
                                    }
                                }
                            }
                        }
                    }
                }
            },
            "post": {
                "tags": [
                    "Products"
                ],
                "summary": "Create product",
                "operationId": "46b57323ea6b26b6b586b2a8287fd93b",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/CreateProductRequest"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Product created successfully",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Product"
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "Validation error"
                    }
                }
            }
        },
        "/api/products/{slug}": {
            "get": {
                "tags": [
                    "Products"
                ],
                "summary": "Get product by slug",
                "operationId": "e96b46af6c1d0794a7dde30b12cb3909",
                "parameters": [
                    {
                        "name": "slug",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string"
                        },
                        "example": "testovaci-vyzivovy-doplnok"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Product detail",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Product"
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "Product not found",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "message": {
                                            "type": "string",
                                            "example": "Product not found."
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/products/{product}": {
            "patch": {
                "tags": [
                    "Products"
                ],
                "summary": "Update a product",
                "operationId": "92f42922ff2fad70bc697bb9b4e46c6c",
                "parameters": [
                    {
                        "name": "product",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/UpdateProductRequest"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Product updated successfully",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Product"
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "Product not found"
                    },
                    "422": {
                        "description": "Validation error"
                    }
                }
            }
        }
    },
    "components": {
        "schemas": {
            "CreateProductRequest": {
                "required": [
                    "product_code",
                    "name",
                    "product_type"
                ],
                "properties": {
                    "product_code": {
                        "type": "string",
                        "example": "VIT-000003"
                    },
                    "name": {
                        "type": "string",
                        "example": "Paralen 500"
                    },
                    "ean": {
                        "type": "string",
                        "example": "8580000000003",
                        "nullable": true
                    },
                    "sukl_code": {
                        "type": "string",
                        "example": "12345",
                        "nullable": true
                    },
                    "product_type": {
                        "type": "string",
                        "example": "human_medicine",
                        "enum": [
                            "human_medicine",
                            "food_supplement"
                        ]
                    },
                    "is_active": {
                        "type": "boolean",
                        "example": true
                    },
                    "description": {
                        "type": "string",
                        "nullable": true
                    },
                    "composition": {
                        "type": "string",
                        "nullable": true
                    },
                    "dosage": {
                        "type": "string",
                        "nullable": true
                    },
                    "usage": {
                        "type": "string",
                        "nullable": true
                    },
                    "warnings": {
                        "type": "string",
                        "nullable": true
                    }
                },
                "type": "object"
            },
            "Product": {
                "properties": {
                    "id": {
                        "type": "integer",
                        "example": 2
                    },
                    "product_code": {
                        "type": "string",
                        "example": "VIT-000002"
                    },
                    "name": {
                        "type": "string",
                        "example": "Testovací výživový doplnok"
                    },
                    "slug": {
                        "type": "string",
                        "example": "testovaci-vyzivovy-doplnok"
                    },
                    "ean": {
                        "type": "string",
                        "example": "8580000000002",
                        "nullable": true
                    },
                    "sukl_code": {
                        "type": "string",
                        "nullable": true
                    },
                    "product_type": {
                        "type": "string",
                        "example": "food_supplement"
                    },
                    "is_active": {
                        "type": "boolean",
                        "example": true
                    },
                    "description": {
                        "type": "string",
                        "nullable": true
                    },
                    "composition": {
                        "type": "string",
                        "nullable": true
                    },
                    "dosage": {
                        "type": "string",
                        "nullable": true
                    },
                    "usage": {
                        "type": "string",
                        "nullable": true
                    },
                    "warnings": {
                        "type": "string",
                        "nullable": true
                    }
                },
                "type": "object"
            },
            "UpdateProductRequest": {
                "properties": {
                    "name": {
                        "type": "string",
                        "example": "Paralen 500 mg"
                    },
                    "ean": {
                        "type": "string",
                        "example": "8584005310017",
                        "nullable": true
                    },
                    "sukl_code": {
                        "type": "string",
                        "example": "12345",
                        "nullable": true
                    },
                    "product_type": {
                        "type": "string",
                        "enum": [
                            "human_medicine",
                            "food_supplement"
                        ]
                    },
                    "is_active": {
                        "type": "boolean",
                        "example": true
                    },
                    "description": {
                        "type": "string",
                        "nullable": true
                    },
                    "composition": {
                        "type": "string",
                        "nullable": true
                    },
                    "dosage": {
                        "type": "string",
                        "nullable": true
                    },
                    "usage": {
                        "type": "string",
                        "nullable": true
                    },
                    "warnings": {
                        "type": "string",
                        "nullable": true
                    }
                },
                "type": "object"
            }
        }
    },
    "tags": [
        {
            "name": "Products",
            "description": "Products"
        }
    ]
}